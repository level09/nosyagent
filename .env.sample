# Required: Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Required: Security - comma-separated Telegram user IDs
ALLOWED_CHAT_IDS=123456789

# Required for production: Webhook URL
WEBHOOK_URL=https://your-domain.com/webhook
PORT=8000

# Optional: Redis for reminders (default: redis://localhost:6379)
# REDIS_URL=redis://localhost:6379

# Optional: Feature toggles (default: on)
# COMPANION_MODE=on
